# Configurações do Servidor
PORT=8002
HOST=0.0.0.0
LOG_LEVEL=INFO

# Dispositivo de Execução ('cuda' ou 'cpu')
LAYA_DEVICE=cuda

# Otimizações de Precisão para GPU ('bf16' ou 'fp16')
LAYA_CUDA_AMP=bf16

# Configurações de Modelos Residentes
LAYA_DEFAULT_MODEL=multilingual
LAYA_PRELOAD_MODELS=multilingual
LAYA_MAX_LOADED=1

# Otimizações para CPU
LAYA_THREADS=4
WORKERS=4

# Motor de Visão (SigLIP / CLIP)
LAYA_ENABLE_VISION=1
LAYA_VISION_MODEL=google/siglip-base-patch16-224
MAX_UPLOAD_SIZE_MB=50

# Diretório de Cache
HF_HOME=/mnt/data/services/laya/cache
